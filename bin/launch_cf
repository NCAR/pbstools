#!/bin/bash

#----------------------------------------------------------------------------
# environment & site config, if any
SCRIPTDIR="$( cd "$( dirname "$(readlink -f ${BASH_SOURCE[0]})" )" >/dev/null 2>&1 && pwd )"
#----------------------------------------------------------------------------

launch_cf_PBS_script="${SCRIPTDIR}/../share/launch_cf.pbs"
launch_cf_cmdline="$(basename ${0}) ${*}"

[ -f ${launch_cf_PBS_script} ] || { echo "ERROR: cannot locate ${launch_cf_PBS_script}"; exit 1; }

#------------------------------------------------------------------
# bash function to count lines not beginning with "#" from a text file
count_non_comment_non_empty_lines ()
{
    i=0
    while read line; do
        # skip comment lines beginning with "#" and empty lines
        [[ ${line:0:1} == "#" || -z "${line// }" ]] && continue || i=$((i + 1))
    done < "${1}"
    echo ${i}
    return 0
}


#------------------------------------------------------------------
usage ()
{
    cat <<EOF
${0} <-h|--help>
     <-q|--queue PBS_QUEUE>
     <--ppn|--processors-per-node #CPUS>
     <--steps-per-node #Steps/node | --nodes #Nodes>
     <--nthreads|--threads-per-step #Threads/step>
     <--mem|--memory RAM/node>
     <--cpu_type TYPE>
     <--random_start_delay MAX_DELAY (sec)>
     <--script PBS_SCRIPT_NAME>
     <--rerun JOBID>
     <--dryrun|--dry-run>
     -A PBS_ACCOUNT -l walltime=01:00:00
     ... other PBS args ...
     <command file>

#------------------------------------------------------------------
Executes a series of commands in a file.  The filename
may be listed as an argument, or defaults to "./cmdfile".

All commands listed in the command file are executed
relative to the submission directory.

The optional bash configuration file "./config_env.sh" will
be sourced prior to command execution, if found, and can therefore
be used to customize the environment with e.g. "module load" commands.

Each node runs up to (#CPUS / #Threads/step) steps at once.  A node given
more steps than that, with --steps-per-node or --nodes, starts the next
step each time a running one finishes, so its steps run in "waves".
Allow walltime for that many steps in a row: launch_cf reports how many
waves each node will run, but cannot know how long the steps take.

--rerun JOBID submits the steps of an earlier launch_cf job that did not
succeed: those that never ran, were cut short, or exited with an error.
Run it from the directory that job was submitted from, where its PBS output
files are.  It writes those steps to a new command file,
./<command file>.<JOBID>.rerun, and submits that with the other options
given, which are not taken from the earlier job.  Each rerun step keeps
its original \${step}.  If the earlier job's output does not record its
command file, give that command file as well.

All options in "<>" brackets are optional.  Any unrecognized arguments
are passed through directly to qsub.
The PBS options -A and -l walltime are required at minimum.

A complete, self-contained PBS job script is written to the current
directory, and that script is what gets submitted.  Every resource
request appears as an ordinary "#PBS" directive, so the job is easy to
inspect after the fact, and the script can be edited and resubmitted by
hand with plain "qsub" without re-running ${0}.  Use --script to choose
the name of the generated script, and --dryrun to generate it (and report
what would be requested) without submitting anything.
#------------------------------------------------------------------

Examples:

  # launches the commands listed in ./cmdfile:
  ${0} -A PBS_ACCOUNT -l walltime=1:00:00

  # launches the OpenMP-threaded commands listed in ./omp_cmdfile:
  ${0} -A PBS_ACCOUNT -l walltime=1:00:00 --nthreads 4 --steps-per-node 32 ./omp_cmdfile

  # spreads the commands in ./cmdfile over 4 nodes, however many there are,
  # running as many at once on each node as it has CPUs:
  ${0} -A PBS_ACCOUNT -l walltime=4:00:00 --nodes 4 ./cmdfile

  # resubmit the steps of job 1234567 that did not succeed:
  ${0} -A PBS_ACCOUNT -l walltime=1:00:00 --rerun 1234567

  # generate ./my_job.pbs and show what would be submitted, but do not submit:
  ${0} -A PBS_ACCOUNT -l walltime=1:00:00 --script ./my_job.pbs --dryrun ./omp_cmdfile
EOF
}


#------------------------------------------------------------------
set_defaults ()
{
    case "${1}" in
        "derecho")
            max_ppn=128
            [ -z "${ppn}" ]       && ppn=${max_ppn}
            [ -z "${mem_limit}" ] && mem_limit="235G"
            [ -z "${queue}" ]     && queue="main"
            ;;
        "casper")
            max_ppn=36
            # use less than full nodes on Casper by default
            [ -z "${ppn}" ]       && ppn=1
            [ -z "${mem_limit}" ] && mem_limit="10G"
            [ -z "${queue}" ]     && queue="casper"
            ;;
        *)
            echo "ERROR: Unrecognized execution host=${1}"
            exit 1
    esac
    return
}


#------------------------------------------------------------------
parse_queue_args ()
{
    while [ ${#} -gt 0 ] ; do
        case ${1} in
            "-q"|"--queue")
                shift
                queue=${1}
                shift
                case ${queue} in
                    *"@casper-pbs"*) execution_host="casper";   ;;
                    *"@desched"*)    execution_host="derecho";  ;;
                esac
                ;;
            # ignore anything else (will get to those in the comprehensive parse_args
            *)
                shift
                ;;
        esac
    done
    return
}

#------------------------------------------------------------------
# is a "#PBS <opt> ..." directive already requested by the user?
# (used so our defaults do not duplicate an explicit user request)
have_directive ()
{
    local opt="${1}" d
    for d in "${user_directives[@]}"; do
        [[ "${d}" == "${opt}" || "${d}" == "${opt} "* ]] && return 0
    done
    return 1
}


#------------------------------------------------------------------
parse_args ()
{
    # var defaults.
    execution_host="${NCAR_HOST}"
    command_file="./cmdfile"
    unset command_file_given
    unset rerun_job
    threads_per_step=1
    max_start_delay=0
    unset ppn
    unset steps_per_node
    unset nodes
    unset ppn_given
    unset cpu_type
    unset mem_limit
    unset queue
    unset script_out
    unset dryrun
    # PBS options we pass through verbatim, one complete directive per entry
    user_directives=()

    # if the user specifies -q|--queue, and the target requires cross-submission, that will
    # influence our defaults.
    parse_queue_args "${@}"
    set_defaults ${execution_host}

    while [ ${#} -gt 0 ] ; do
        # check the first argument
        case ${1} in

            "-J"|*"select"*)
                echo "ERROR: \"${1}\"is not allowed as an argument, rather is inferred from the number of command file steps and other arguments."
                echo
                echo "Run ${0} --help for additional details"
                exit 1
                ;;

            "-h"|"--help")
                usage
                shift
                exit 1
                ;;

            "-q"|"--queue")
                shift
                queue=${1}
                shift
                ;;

            "--ppn"|"--processors-per-node")
                shift
                ppn=${1}
                ppn_given="yes"
                shift
                ;;

            "--steps-per-node")
                shift
                steps_per_node=${1}
                shift
                ;;

            "--nodes")
                shift
                nodes=${1}
                shift
                ;;

            "--nthreads"|"--threads-per-step")
                shift
                threads_per_step=${1}
                shift
                ;;

            "--mem"|"--memory")
                shift
                mem_limit=${1}
                shift
                ;;

            "--cpu_type")
                shift
                cpu_type=${1}
                shift
                ;;

            "--random_start_delay")
                shift
                max_start_delay=${1}
                shift
                ;;

            "--script"|"--script-name")
                shift
                script_out=${1}
                shift
                ;;

            "--rerun")
                shift
                rerun_job=${1}
                shift
                ;;

            "--dryrun"|"--dry-run")
                dryrun="yes"
                shift
                ;;

            *)
                if [ -f "${1}" ]; then
                    command_file="${1}"
                    command_file_given="yes"
                    shift
                elif [ "${1:0:1}" = "-" ]; then
                    # a PBS option, destined for a "#PBS" directive in the generated script.
                    pbs_opt="${1}"
                    shift
                    case "${pbs_opt}" in
                        # PBS options that stand alone, taking no value
                        "-I"|"-V"|"-X"|"-f"|"-z")
                            user_directives+=( "${pbs_opt}" )
                            ;;
                        # a lone short option: its value is the next argument, e.g. "-A ACCOUNT"
                        -[a-zA-Z])
                            [ ${#} -gt 0 ] || { echo "ERROR: PBS option \"${pbs_opt}\" requires a value"; exit 1; }
                            user_directives+=( "${pbs_opt} ${1}" )
                            shift
                            ;;
                        # value attached to the option, e.g. "-lwalltime=01:00:00"
                        *)
                            user_directives+=( "${pbs_opt}" )
                            ;;
                    esac
                else
                    echo "ERROR: unrecognized argument \"${1}\""
                    echo "       (if this was intended to be the command file, it does not exist or is not readable)"
                    echo
                    echo "Run ${0} --help for additional details"
                    exit 1
                fi
                ;;
        esac
    done

    # the select statement and the array range are ours to compute; reject them in
    # any of their forms, including e.g. "-l select=..." split across two arguments.
    local d
    for d in "${user_directives[@]}"; do
        case "${d}" in
            "-J"*|*"select"*)
                echo "ERROR: \"${d}\" is not allowed as an argument, rather is inferred from the number of command file steps and other arguments."
                echo
                echo "Run ${0} --help for additional details"
                exit 1
                ;;
        esac
    done

    # Consistency
    local opt val
    for opt in "--ppn:${ppn}" "--steps-per-node:${steps_per_node-1}" "--nodes:${nodes-1}" "--nthreads:${threads_per_step}"; do
        val="${opt#*:}"
        [[ "${val}" =~ ^[1-9][0-9]*$ ]] || { echo "ERROR: ${opt%%:*} must be a positive whole number, not \"${val}\""; exit 1; }
    done
    [ -n "${nodes}" -a -n "${steps_per_node}" ] && { echo "ERROR: give --steps-per-node or --nodes, not both"; exit 1; }
    [ ${threads_per_step} -gt ${max_ppn} ] && { echo "ERROR: threads_per_step>${max_ppn}, inconsistent inputs?!"; usage; exit 1; }
    [ ${threads_per_step} -gt ${ppn} ] && ppn=${threads_per_step}

    [ ${ppn} -gt ${max_ppn} ] && { echo "ERROR: ppn>${max_ppn}, inconsistent inputs?!"; usage; exit 1; }

    return
}

#------------------------------------------------------------------
# --rerun JOBID: from the PBS output files of job ${rerun_job} in the current
# directory, write a command file of the steps that did not succeed -- those
# that never ran, were cut short, or exited with an error -- and make it the
# command file to submit.
make_rerun_cmdfile ()
{
    local seq server outputs names logdir d qid state listing N spn original raw t i n_failed
    local kept_step='^step=[0-9]+; '
    local reasons=()

    seq="${rerun_job%%[^0-9]*}"
    [ -n "${seq}" ] || { echo "ERROR: --rerun expects a job ID, e.g. 1234567 or 1234567[].casper-pbs, not \"${rerun_job}\""; exit 1; }
    [[ "${rerun_job}" == *.* ]] && server="${rerun_job#*.}"

    # the job's PBS output files: <job name>.o<seq>, or <job name>.o<seq>.<index>
    # for each element of a job array.
    shopt -s nullglob
    outputs=( *.o${seq} *.o${seq}.[0-9]* )
    shopt -u nullglob
    if [ ${#outputs[@]} -eq 0 ]; then
        echo "ERROR: no PBS output files of job ${seq} (*.o${seq}*) in $(pwd)"
        echo "       Run launch_cf --rerun from the directory the job was submitted from."
        exit 1
    fi
    names=$(printf '%s\n' "${outputs[@]}" | sed -E 's/\.o[0-9]+(\.[0-9]+)?$//' | sort -u)
    [ $(echo "${names}" | wc -l) -eq 1 ] || { echo "ERROR: $(pwd) has output files of more than one job numbered ${seq}: $(echo ${names})"; exit 1; }

    # the per-step logs, named for the job id, e.g. stdout-1234567.casper-pbs
    for d in "stdout-${seq}${server:+.${server}}" stdout-${seq} stdout-${seq}.*; do
        [ -d "${d}" ] && { logdir="${d}"; break; }
    done
    [ -z "${server}" -a -n "${logdir}" ] && [[ "${logdir}" == *.* ]] && server="${logdir#*.}"

    # a job still queued or running has steps yet to run.  Go by the state
    # qstat reports for the job, not by its exit status: a finished job is
    # reported with none (or as F or X), and so is one PBS does not know.
    if command -v qstat >/dev/null 2>&1; then
        if [[ "${outputs[0]}" =~ \.o[0-9]+\.[0-9]+$ ]]; then qid="${seq}[]"; else qid="${seq}"; fi
        qid="${qid}${server:+.${server}}"
        state=$(qstat -f "${qid}" 2>/dev/null | awk -F' = ' '$1 ~ /^[[:space:]]*job_state$/ { print $2; exit }')
        case "${state}" in
            ""|"F"|"X") ;;
            *) echo "ERROR: job ${qid} is still queued or running (state ${state}); rerun its steps once it has finished"; exit 1 ;;
        esac
    fi

    # A step succeeded only if its subjob reported it finishing with exit
    # status 0.  Prints the job's total steps, steps/node and command file,
    # then one "step<TAB>reason" line for each step that did not succeed.
    listing=$(awk -v logdir="${logdir}" '
        FNR == 1 { idx = "" }
        index($0, "(#steps at once) = ") == 1 { reports_finishing = 1 }
        index($0, "(#steps/node) x (#threads/step) = ") == 1 { spn = substr($0, 35) + 0 }
        /^command_file: / && cf == "" { cf = substr($0, 15) }
        /^n_total_steps: [0-9]+, PBS_ARRAY_INDEX=[0-9]+/ {
            N = $2 + 0
            match($0, /PBS_ARRAY_INDEX=[0-9]+/); idx = substr($0, RSTART + 16, RLENGTH - 16) + 0
            ran[idx] = 1
        }
        match($0, / launching step [0-9]+:/) { launched[substr($0, RSTART + 16, RLENGTH - 17) + 0] = 1 }
        match($0, / finished  step [0-9]+: exit status [0-9]+/) {
            split(substr($0, RSTART + 16, RLENGTH - 16), t, ": exit status ")
            status[t[1] + 0] = t[2] + 0
        }
        /^Done: PBS_ARRAY_INDEX=/ && idx != "" { done[idx] = 1 }
        END {
            if (!reports_finishing) { print "old"; exit }
            if (N == "" || spn == "") { print "none"; exit }
            printf "%d\t%d\t%s\n", N, spn, cf
            for (i = 1; i <= N; i++) {
                if ((i in status) && status[i] == 0) continue
                sub_idx = int((i - 1) / spn)
                if (i in status)
                    reason = sprintf("exited with status %d%s", status[i], (logdir == "" ? "" : sprintf(", see %s/step-%05d.out", logdir, i)))
                else if ((i in launched) && !(sub_idx in done))
                    reason = "cut short: subjob " sub_idx " stopped while it ran"
                else if (i in launched)
                    reason = "launched but never reported finishing"
                else if (!(sub_idx in ran))
                    reason = "never ran: subjob " sub_idx " did not run"
                else
                    reason = "never ran: subjob " sub_idx " stopped first"
                print i "\t" reason
            }
        }' "${outputs[@]}")

    case "${listing}" in
        "old")
            echo "ERROR: job ${seq} was run by a version of launch_cf that does not report its steps finishing,"
            echo "       so the steps that did not succeed cannot be told apart."
            exit 1 ;;
        "none")
            echo "ERROR: none of the subjobs of job ${seq} started, so its layout is unknown."
            echo "       Resubmit its job script with qsub instead."
            exit 1 ;;
    esac
    IFS=$'\t' read -r N spn original <<< "$(head -1 <<< "${listing}")"

    # the command file the job ran, which a command file given here replaces
    if [ -n "${command_file_given}" ]; then
        [ -n "${original}" -a "$(readlink -f "${command_file}")" != "${original}" ] && \
            echo "NOTE: using ${command_file}, not ${original} recorded by job ${seq}"
        original="${command_file}"
    elif [ -z "${original}" ]; then
        echo "ERROR: the output of job ${seq} does not record its command file; give it after --rerun ${rerun_job}"
        exit 1
    fi
    [ -r "${original}" ] || { echo "ERROR: cannot read ${original}, the command file of job ${seq}"; exit 1; }
    [ $(count_non_comment_non_empty_lines "${original}") -eq ${N} ] || \
        { echo "ERROR: ${original} no longer has the ${N} steps job ${seq} ran, so its steps cannot be matched"; exit 1; }

    n_failed=$(( $(wc -l <<< "${listing}") - 1 ))
    if [ ${n_failed} -eq 0 ]; then
        echo "All ${N} steps of job ${seq} succeeded; there is nothing to rerun."
        exit 0
    fi

    echo "Job ${seq}: ${n_failed} of ${N} steps did not succeed:"
    tail -n +2 <<< "${listing}" | awk -F'\t' -v seq=${seq} 'NR <= 10 { printf "  step %d of job %s: %s\n", $1, seq, $2 } END { if (NR > 10) printf "  ... and %d more\n", NR - 10 }'

    while IFS=$'\t' read -r i t; do
        reasons[${i}]="${t}"
    done < <(tail -n +2 <<< "${listing}")

    # copy those steps from the command file, counting steps exactly as
    # count_non_comment_non_empty_lines does.  Each keeps its original ${step},
    # which a step of an earlier rerun already sets.
    rerun_file="./$(basename "${original}" | sed -E 's/\.[0-9]+\.rerun$//').${seq}.rerun"
    {
        echo "# the ${n_failed} steps of job ${rerun_job} that did not succeed, out of ${N} in"
        echo "# ${original}"
        echo "# written by: ${launch_cf_cmdline}"
        i=0
        while IFS= read -r raw; do
            t="${raw#"${raw%%[![:space:]]*}"}"
            [[ ${t:0:1} == "#" || -z "${t}" ]] && continue
            i=$((i + 1))
            [ -n "${reasons[${i}]}" ] || continue
            echo "# step ${i} of job ${seq}: ${reasons[${i}]}"
            if [[ "${raw}" =~ ${kept_step} ]]; then
                echo "${raw}"
            else
                echo "step=$((i - 1)); ${raw}"
            fi
        done < "${original}"
    } > "${rerun_file}" || { echo "ERROR: cannot write ${rerun_file}"; exit 1; }

    echo "Wrote ${rerun_file}, to submit as the command file."
    echo
    command_file="${rerun_file}"
    return 0
}


#------------------------------------------------------------------
# write the complete, self-contained PBS job script we will submit.
write_pbs_script ()
{
    local d
    {
        echo "#!/bin/bash"
        for d in "${directives[@]}"; do
            printf '#PBS %s\n' "${d}"
        done

        cat <<EOF

#----------------------------------------------------------------------------
# PBS job script generated by launch_cf.
#
#   generated       : $(date)
#   submission dir  : $(pwd)
#   launch_cf call  : ${launch_cf_cmdline}
#
#   command file    : ${command_file_abs}
#   total steps     : ${n_total_steps}
#   steps / node    : ${steps_per_node}
#   steps at once   : ${steps_at_once} per node, in ${waves_per_node} wave(s)
#   threads / step  : ${threads_per_step}
#   cpus / node     : ${ppn}
#   array indices   : ${array_desc}
#
# This script is self-contained.  It can be inspected, edited, and resubmitted
# directly with "qsub ${script_out}", without re-running launch_cf.
#----------------------------------------------------------------------------

#----------------------------------------------------------------------------
# settings baked in by launch_cf.  Each can still be overridden at submit
# time, e.g.:
#     qsub -v max_start_delay=0 ${script_out}
# The job was sized for this command file, so a replacement command_file must
# have the same number of steps (${n_total_steps}); for any other command file,
# run launch_cf again.
command_file="\${command_file:-${command_file_abs}}"
n_total_steps="\${n_total_steps:-${n_total_steps}}"
max_start_delay="\${max_start_delay:-${max_start_delay}}"
# the steps each array element runs.  The job array was sized for it, so it
# cannot be overridden.
steps_per_node=${steps_per_node}
#----------------------------------------------------------------------------
EOF
    } > "${script_out}" || { echo "ERROR: cannot write ${script_out}"; exit 1; }

    header_lines=$(wc -l < "${script_out}")

    # append the body of the launch_cf PBS template, less its shebang and its own
    # #PBS directives (ours, above, are complete).
    sed -e '/^#!\/bin\/bash/d' \
        -e '/^[[:space:]]*#PBS[[:space:]]/d' \
        "${launch_cf_PBS_script}" >> "${script_out}"

    chmod +x "${script_out}"
    return 0
}


#------------------------------------------------------------------
# defaults & user arguments
parse_args "${@}"

[ -n "${rerun_job}" ] && make_rerun_cmdfile

#------------------------------------------------------------------
# error & consistency checking
[ -r ${command_file} ] || { echo "Cannot locate requested command file: ${command_file}"; exit 1; }

# the generated script is meant to stand on its own, so refer to the command
# file by absolute path.
command_file_abs="$(readlink -f ${command_file})"

#------------------------------------------------------------------
# main execution follows...
n_total_steps=$(count_non_comment_non_empty_lines ${command_file})

echo "Found n_total_steps=${n_total_steps} in ${command_file}"
[ ${n_total_steps} -gt 0 ] || { echo "ERROR: no steps to run in ${command_file}"; exit 1; }

# steps per node: given, spread over the requested number of nodes, or as
# many as run at once on a node.
if [ -n "${nodes}" ]; then
    steps_per_node=$(( (${n_total_steps} + ${nodes} - 1) / ${nodes} ))
elif [ -z "${steps_per_node}" ]; then
    steps_per_node=$(( ${ppn} / ${threads_per_step} ))
fi

# unless --ppn was given, request enough CPUs to run every step of a node at
# once, up to a full node.  Steps beyond that run as earlier ones finish.
if [ -z "${ppn_given}" -a $(( ${steps_per_node}*${threads_per_step} )) -gt ${ppn} ]; then
    ppn=$(( ${steps_per_node}*${threads_per_step} ))
    [ ${ppn} -gt ${max_ppn} ] && ppn=${max_ppn}
fi

# when the command file has fewer steps than our ${steps_per_node}, adjust.
[ ${n_total_steps} -lt ${steps_per_node} ] && steps_per_node=${n_total_steps}

# how many steps each node runs at once, and so in how many waves it runs them.
steps_at_once=$(( ${ppn} / ${threads_per_step} ))
[ ${steps_at_once} -gt ${steps_per_node} ] && steps_at_once=${steps_per_node}
waves_per_node=$(( (${steps_per_node} + ${steps_at_once} - 1) / ${steps_at_once} ))

#------------------------------------------------------------------
njobs=$(( ${n_total_steps} / ${steps_per_node} ))
# evenly divisible?
[ $(( ${njobs} * ${steps_per_node} )) -eq ${n_total_steps} ] && njobs=$((${njobs}-1))

echo " -> ppn=${ppn}"
echo " -> threads_per_step=${threads_per_step}"
echo " -> steps_per_node=${steps_per_node}"
echo " -> steps_at_once=${steps_at_once}"
echo " -> waves_per_node=${waves_per_node}"
echo " -> n_total_steps=${n_total_steps}"
echo " -> njobs=${njobs}"

echo "Running $((${njobs}+1)) jobs with ${steps_per_node} steps / node on NCAR resource ${execution_host}"
[ -n "${nodes}" -a $((${njobs}+1)) -lt ${nodes:-0} ] && \
    echo "NOTE: ${n_total_steps} steps at ${steps_per_node} steps / node need only $((${njobs}+1)) of the ${nodes} nodes requested"
if [ ${waves_per_node} -gt 1 ]; then
    echo "NOTE: each node runs ${steps_at_once} steps at once, so its ${steps_per_node} steps run in ${waves_per_node} waves."
    echo "      Request walltime for up to ${waves_per_node} steps in a row."
fi

# mpiprocs is the number of steps each node runs at once.
ss="1:ncpus=${ppn}:mpiprocs=${steps_at_once}:ompthreads=${threads_per_step}:mem=${mem_limit}"

#------------------------------------------------------------------
# assemble the complete, ordered list of #PBS directives for the generated
# script.  Our defaults are skipped when the user requested them explicitly,
# so we never emit the same single-valued option twice.
directives=()
have_directive "-N" || directives+=( "-N launch_cf" )
have_directive "-j" || directives+=( "-j oe" )
have_directive "-r" || directives+=( "-r y" )
directives+=( "-q ${queue}" )
directives+=( "-l select=${ss}" )

# append cpu_type as its own resource request, if set.
[ -n "${cpu_type}" ] && directives+=( "-l cpu_type=${cpu_type}" )

# hackery: PBS will not allow us to submit a 1-entry array.
# for that case we will be submitted without a -J arg
if [ ${njobs} -gt 0 ]; then
    directives+=( "-J 0-${njobs}" )
    array_desc="0-${njobs} ($((${njobs}+1)) array steps)"
else
    array_desc="none (single step; PBS does not allow a 1-entry job array)"
fi

# ... followed by whatever the user passed through for PBS
directives+=( "${user_directives[@]}" )

#------------------------------------------------------------------
# name & write the job script
[ -z "${script_out}" ] && script_out="./launch_cf.$(basename ${command_file}).$(date +%Y%m%d-%H%M%S).pbs"

write_pbs_script

echo
echo "Generated PBS job script: ${script_out}"

#------------------------------------------------------------------
if [ -n "${dryrun}" ]; then
    echo
    sed -n "1,${header_lines}p" "${script_out}"
    echo "... (command file execution logic follows, see ${script_out})"
    echo
    echo "DRYRUN: nothing was submitted.  To submit this job as-is, run:"
    echo "  qsub ${script_out}"
    exit 0
fi

echo "Submitting: qsub ${script_out}"
qsub "${script_out}"
