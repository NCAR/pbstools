#!/bin/bash

#----------------------------------------------------------------------------
# environment & site config, if any
SCRIPTDIR="$( cd "$( dirname "$(readlink -f ${BASH_SOURCE[0]})" )" >/dev/null 2>&1 && pwd )"
#----------------------------------------------------------------------------

launch_cf_PBS_script="${SCRIPTDIR}/../share/launch_cf.pbs"
launch_cf_cmdline="$(basename ${0}) ${*}"

[ -f ${launch_cf_PBS_script} ] || { echo "ERROR: cannot locate ${launch_cf_PBS_script}"; exit 1; }

#------------------------------------------------------------------
# bash function to count lines not beginning with "#" from a text file
count_non_comment_non_empty_lines ()
{
    i=0
    while read line; do
        # skip comment lines beginning with "#" and empty lines
        [[ ${line:0:1} == "#" || -z "${line// }" ]] && continue || i=$((i + 1))
    done < "${1}"
    echo ${i}
    return 0
}


#------------------------------------------------------------------
usage ()
{
    cat <<EOF
${0} <-h|--help>
     <-q|--queue PBS_QUEUE>
     <--ppn|--processors-per-node #CPUS>
     <--steps-per-node #Steps/node>
     <--nthreads|--threads-per-step #Threads/step>
     <--mem|--memory RAM/node>
     <--cpu_type TYPE>
     <--random_start_delay MAX_DELAY (sec)>
     <--script PBS_SCRIPT_NAME>
     -A PBS_ACCOUNT -l walltime=01:00:00
     ... other PBS args ...
     <command file>

#------------------------------------------------------------------
Executes a series of commands in a file.  The filename
may be listed as an argument, or defaults to "./cmdfile".

All commands listed in the command file are executed
relative to the submission directory.

The optional bash configuration file "./config_env.sh" will
be sourced prior to command execution, if found, and can therefore
be used to customize the environment with e.g. "module load" commands.

All options in "<>" brackets are optional.  Any unrecognized arguments
are passed through directly to qsub.
The PBS options -A and -l walltime are required at minimum.

A complete, self-contained PBS job script is written to the current
directory, and that script is what gets submitted.  Every resource
request appears as an ordinary "#PBS" directive, so the job is easy to
inspect after the fact, and the script can be edited and resubmitted by
hand with plain "qsub" without re-running ${0}.  Use --script to choose
the name of the generated script.
#------------------------------------------------------------------

Examples:

  # launches the commands listed in ./cmdfile:
  ${0} -A PBS_ACCOUNT -l walltime=1:00:00

  # launches the OpenMP-threaded commands listed in ./omp_cmdfile:
  ${0} -A PBS_ACCOUNT -l walltime=1:00:00 --nthreads 4 --steps-per-node 32 ./omp_cmdfile
EOF
}


#------------------------------------------------------------------
set_defaults ()
{
    case "${1}" in
        "derecho")
            max_ppn=128
            [ -z "${ppn}" ]       && ppn=${max_ppn}
            [ -z "${mem_limit}" ] && mem_limit="235G"
            [ -z "${queue}" ]     && queue="main"
            ;;
        "casper")
            max_ppn=36
            # use less than full nodes on Casper by default
            [ -z "${ppn}" ]       && ppn=1
            [ -z "${mem_limit}" ] && mem_limit="10G"
            [ -z "${queue}" ]     && queue="casper"
            ;;
        *)
            echo "ERROR: Unrecognized execution host=${1}"
            exit 1
    esac
    return
}


#------------------------------------------------------------------
parse_queue_args ()
{
    while [ ${#} -gt 0 ] ; do
        case ${1} in
            "-q"|"--queue")
                shift
                queue=${1}
                shift
                case ${queue} in
                    *"@casper-pbs"*) execution_host="casper";   ;;
                    *"@desched"*)    execution_host="derecho";  ;;
                esac
                ;;
            # ignore anything else (will get to those in the comprehensive parse_args
            *)
                shift
                ;;
        esac
    done
    return
}

#------------------------------------------------------------------
# is a "#PBS <opt> ..." directive already requested by the user?
# (used so our defaults do not duplicate an explicit user request)
have_directive ()
{
    local opt="${1}" d
    for d in "${user_directives[@]}"; do
        [[ "${d}" == "${opt}" || "${d}" == "${opt} "* ]] && return 0
    done
    return 1
}


#------------------------------------------------------------------
parse_args ()
{
    # var defaults.
    execution_host="${NCAR_HOST}"
    command_file="./cmdfile"
    threads_per_step=1
    max_start_delay=0
    unset ppn
    unset steps_per_node
    unset cpu_type
    unset mem_limit
    unset queue
    unset script_out
    # PBS options we pass through verbatim, one complete directive per entry
    user_directives=()

    # if the user specifies -q|--queue, and the target requires cross-submission, that will
    # influence our defaults.
    parse_queue_args "${@}"
    set_defaults ${execution_host}

    while [ ${#} -gt 0 ] ; do
        # check the first argument
        case ${1} in

            "-J"|*"select"*)
                echo "ERROR: \"${1}\"is not allowed as an argument, rather is inferred from the number of command file steps and other arguments."
                echo
                echo "Run ${0} --help for additional details"
                exit 1
                ;;

            "-h"|"--help")
                usage
                shift
                exit 1
                ;;

            "-q"|"--queue")
                shift
                queue=${1}
                shift
                ;;

            "--ppn"|"--processors-per-node")
                shift
                ppn=${1}
                shift
                ;;

            "--steps-per-node")
                shift
                steps_per_node=${1}
                shift
                ;;

            "--nthreads"|"--threads-per-step")
                shift
                threads_per_step=${1}
                shift
                ;;

            "--mem"|"--memory")
                shift
                mem_limit=${1}
                shift
                ;;

            "--cpu_type")
                shift
                cpu_type=${1}
                shift
                ;;

            "--random_start_delay")
                shift
                max_start_delay=${1}
                shift
                ;;

            "--script"|"--script-name")
                shift
                script_out=${1}
                shift
                ;;

            *)
                if [ -f "${1}" ]; then
                    command_file="${1}"
                    shift
                elif [ "${1:0:1}" = "-" ]; then
                    # a PBS option, destined for a "#PBS" directive in the generated script.
                    pbs_opt="${1}"
                    shift
                    case "${pbs_opt}" in
                        # PBS options that stand alone, taking no value
                        "-I"|"-V"|"-X"|"-f"|"-z")
                            user_directives+=( "${pbs_opt}" )
                            ;;
                        # a lone short option: its value is the next argument, e.g. "-A ACCOUNT"
                        -[a-zA-Z])
                            [ ${#} -gt 0 ] || { echo "ERROR: PBS option \"${pbs_opt}\" requires a value"; exit 1; }
                            user_directives+=( "${pbs_opt} ${1}" )
                            shift
                            ;;
                        # value attached to the option, e.g. "-lwalltime=01:00:00"
                        *)
                            user_directives+=( "${pbs_opt}" )
                            ;;
                    esac
                else
                    echo "ERROR: unrecognized argument \"${1}\""
                    echo "       (if this was intended to be the command file, it does not exist or is not readable)"
                    echo
                    echo "Run ${0} --help for additional details"
                    exit 1
                fi
                ;;
        esac
    done

    # the select statement and the array range are ours to compute; reject them in
    # any of their forms, including e.g. "-l select=..." split across two arguments.
    local d
    for d in "${user_directives[@]}"; do
        case "${d}" in
            "-J"*|*"select"*)
                echo "ERROR: \"${d}\" is not allowed as an argument, rather is inferred from the number of command file steps and other arguments."
                echo
                echo "Run ${0} --help for additional details"
                exit 1
                ;;
        esac
    done

    # Consistency
    [ ${threads_per_step} -gt ${ppn} ] && ppn=${threads_per_step}
    [ -z "${steps_per_node}" ] && steps_per_node=$(( ${ppn} / ${threads_per_step} ))
    [ $(( ${steps_per_node}*${threads_per_step})) -gt ${max_ppn} ] && { echo "steps_per_node*threads_per_step>${max_ppn}, inconsistent inputs?!"; usage; exit 1; }
    [ $(( ${steps_per_node}*${threads_per_step})) -gt ${ppn} ] && ppn=$(( ${steps_per_node}*${threads_per_step}))

    [ ${ppn} -gt ${max_ppn} ] && { echo "ppn>${max_ppn}m inconsistent inputs?!"; usage; exit 1; }

    return
}

#------------------------------------------------------------------
# write the complete, self-contained PBS job script we will submit.
write_pbs_script ()
{
    local d
    {
        echo "#!/bin/bash"
        for d in "${directives[@]}"; do
            printf '#PBS %s\n' "${d}"
        done

        cat <<EOF

#----------------------------------------------------------------------------
# PBS job script generated by launch_cf.
#
#   generated       : $(date)
#   submission dir  : $(pwd)
#   launch_cf call  : ${launch_cf_cmdline}
#
#   command file    : ${command_file_abs}
#   total steps     : ${n_total_steps}
#   steps / node    : ${steps_per_node}
#   threads / step  : ${threads_per_step}
#   cpus / node     : ${ppn}
#   array indices   : ${array_desc}
#
# This script is self-contained.  It can be inspected, edited, and resubmitted
# directly with "qsub ${script_out}", without re-running launch_cf.
#----------------------------------------------------------------------------

#----------------------------------------------------------------------------
# settings baked in by launch_cf.  Each can still be overridden at submit time,
# e.g. "qsub -v command_file=./other_cmdfile ${script_out}"
command_file="\${command_file:-${command_file_abs}}"
n_total_steps="\${n_total_steps:-${n_total_steps}}"
max_start_delay="\${max_start_delay:-${max_start_delay}}"
#----------------------------------------------------------------------------
EOF
    } > "${script_out}" || { echo "ERROR: cannot write ${script_out}"; exit 1; }

    header_lines=$(wc -l < "${script_out}")

    # append the body of the launch_cf PBS template, less its shebang and its own
    # #PBS directives (ours, above, are complete).
    sed -e '/^#!\/bin\/bash/d' \
        -e '/^[[:space:]]*#PBS[[:space:]]/d' \
        "${launch_cf_PBS_script}" >> "${script_out}"

    chmod +x "${script_out}"
    return 0
}


#------------------------------------------------------------------
# defaults & user arguments
parse_args "${@}"

#------------------------------------------------------------------
# error & consistency checking
[ -r ${command_file} ] || { echo "Cannot locate requested command file: ${command_file}"; exit 1; }

# the generated script is meant to stand on its own, so refer to the command
# file by absolute path.
command_file_abs="$(readlink -f ${command_file})"

#------------------------------------------------------------------
# main execution follows...
n_total_steps=$(count_non_comment_non_empty_lines ${command_file})

echo "Found n_total_steps=${n_total_steps} in ${command_file}"

# when the command file has fewer steps than our ${steps_per_node}, adjust.
[ ${n_total_steps} -lt ${steps_per_node} ] && steps_per_node=${n_total_steps}
#[ ${n_total_steps} -lt ${ppn} ]            && ppn=${n_total_steps}

#------------------------------------------------------------------
njobs=$(( ${n_total_steps} / ${steps_per_node} ))
# evenly divisible?
[ $(( ${njobs} * ${steps_per_node} )) -eq ${n_total_steps} ] && njobs=$((${njobs}-1))

echo " -> ppn=${ppn}"
echo " -> threads_per_step=${threads_per_step}"
echo " -> steps_per_node=${steps_per_node}"
echo " -> n_total_steps=${n_total_steps}"
echo " -> njobs=${njobs}"

echo "Running $((${njobs}+1)) jobs with ${steps_per_node} steps / node on NCAR resource ${execution_host}"

ss="1:ncpus=${ppn}:mpiprocs=${steps_per_node}:ompthreads=${threads_per_step}:mem=${mem_limit}"

#------------------------------------------------------------------
# assemble the complete, ordered list of #PBS directives for the generated
# script.  Our defaults are skipped when the user requested them explicitly,
# so we never emit the same single-valued option twice.
directives=()
have_directive "-N" || directives+=( "-N launch_cf" )
have_directive "-j" || directives+=( "-j oe" )
have_directive "-r" || directives+=( "-r y" )
directives+=( "-q ${queue}" )
directives+=( "-l select=${ss}" )

# append cpu_type as its own resource request, if set.
[ -n "${cpu_type}" ] && directives+=( "-l cpu_type=${cpu_type}" )

# hackery: PBS will not allow us to submit a 1-entry array.
# for that case we will be submitted without a -J arg
if [ ${njobs} -gt 0 ]; then
    directives+=( "-J 0-${njobs}" )
    array_desc="0-${njobs} ($((${njobs}+1)) array steps)"
else
    array_desc="none (single step; PBS does not allow a 1-entry job array)"
fi

# ... followed by whatever the user passed through for PBS
directives+=( "${user_directives[@]}" )

#------------------------------------------------------------------
# name & write the job script
[ -z "${script_out}" ] && script_out="./launch_cf.$(basename ${command_file}).$(date +%Y%m%d-%H%M%S).pbs"

write_pbs_script

echo
echo "Generated PBS job script: ${script_out}"

echo "Submitting: qsub ${script_out}"
qsub "${script_out}"
