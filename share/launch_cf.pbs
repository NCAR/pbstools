#!/bin/bash
#PBS -N launch_cf
#PBS -j oe

#------------------------------------------------------------------
# bash function to extract the desired line number from a text file
# (0-based indexing)
getline_from_file ()
{
    # ref: https://www.baeldung.com/linux/read-specific-line-from-file
    FILE="${1}"
    LINE_NO=${2}

    i=0
    while read line; do
        # skip comment lines beginning with "#" and empty lines, exactly as
        # launch_cf does when counting steps -- otherwise the indices here and
        # the step count it computed refer to different lines.
        [[ ${line:0:1} == "#" || -z "${line// }" ]] && continue

        test ${i} = ${LINE_NO} && echo "${line}" && return
        i=$((i + 1))
    done < "${FILE}"

    echo "ERROR: line ${LINE_NO} not found, is ${FILE} too short? (only found ${i} non-comment lines)"
    exit 1
}

#------------------------------------------------------------------
# bash function to count the steps in a command file, skipping lines
# exactly as getline_from_file does
count_steps_in_file ()
{
    i=0
    while read line; do
        [[ ${line:0:1} == "#" || -z "${line// }" ]] && continue
        i=$((i + 1))
    done < "${1}"
    echo ${i}
}
#------------------------------------------------------------------

tstart=$(date +%s)

# print PBS-related environment variables
# env | egrep "PBS|THREAD" | sort | uniq

### Set temp to scratch, if ${SCRATCH } is set
[ -n ${SCRATCH} ] && export TMPDIR=${SCRATCH}/tmp && mkdir -p ${TMPDIR}

# potentially source a users requested environment configuration
[ -f ./config_env.sh ] && source ./config_env.sh

# command file to read, potentially from environment
command_file="${command_file:-./cmdfile}"
[ -r ${command_file} ] || { echo "Cannot locate requested command file: ${command_file}"; exit 1; }

## determine the number of nodes, and the number of steps to run at once on
## each, from the mpiprocs we were assigned (inferred from the ${PBS_NODEFILE})
nodeslist=( $(cat ${PBS_NODEFILE} | sort | uniq | cut -d'.' -f1) )
nnodes=$(cat ${PBS_NODEFILE} | sort | uniq | wc -l)
nranks=$(cat ${PBS_NODEFILE} | sort | wc -l)
nranks_per_node=$((${nranks} / ${nnodes}))

[ ${nnodes} -eq 1 ] || { echo "ERROR: this example is intended to be run on 1 node, but with perhaps many array steps"; exit 1; }

# the steps this node runs, set by launch_cf.  If unset, this node runs as
# many steps as it runs at once.
steps_per_node=${steps_per_node:-${nranks_per_node}}
steps_at_once=${nranks_per_node}
[ ${steps_at_once} -gt ${steps_per_node} ] && steps_at_once=${steps_per_node}
waves_per_node=$(( (${steps_per_node} + ${steps_at_once} - 1) / ${steps_at_once} ))

echo "(#steps/node) x (#threads/step) = ${steps_per_node} x ${OMP_NUM_THREADS}"
echo "(#steps at once) = ${steps_at_once}, in ${waves_per_node} wave(s)"

if [ -z "${n_total_steps}" ]; then
    echo "Failed to get \${n_total_steps} from environment!"
    exit 1
fi

# hackery: PBS will not allow us to submit a 1-entry array.
# so for that case we will be submitted without a -J arg, yet
# still want the PBS_ARRAY_INDEX and PBS_ARRAY_ID defined...
if [ -z "${PBS_ARRAY_INDEX}" ]; then
    PBS_ARRAY_INDEX=0
    PBS_ARRAY_ID=${PBS_JOBID}
fi

# max_start_delay, optional, from environment.
# (If unset, set to 0, which means the % function below will return 0.)
if [ -z "${max_start_delay}" ]; then
    max_start_delay=0
fi

# this PBS_ARRAY_INDEX will compute multiple "steps" from ${command_file}, up to steps_per_node
start_idx=$(( ${PBS_ARRAY_INDEX} * ${steps_per_node} ))
stop_idx=$(( ${start_idx} + ${steps_per_node} - 1 ))

echo "n_total_steps: ${n_total_steps}, PBS_ARRAY_INDEX=${PBS_ARRAY_INDEX}"
echo "start_idx=${start_idx} stop_idx=${stop_idx} "
[ ${max_start_delay} -ne 0 ] && echo "max_start_delay=${max_start_delay}"

# this job was sized for ${n_total_steps} steps.  If the command file now has a
# different number, e.g. another one given with "qsub -v command_file=...",
# stop before running any of them rather than run the wrong set.
n_file_steps=$(count_steps_in_file ${command_file})
if [ ${n_file_steps} -ne ${n_total_steps} ]; then
    echo "ERROR: ${command_file} has ${n_file_steps} steps, but this job was sized for ${n_total_steps}."
    echo "       Run launch_cf again to submit a job sized for this command file."
    exit 1
fi

# create a logs directory to hold stdout from each process
logs_dir=stdout-${PBS_ARRAY_ID/"[]"/}
mkdir -p ./${logs_dir}

# how to wait for any one running step to finish ("wait -n" needs bash 4.3)
if [ ${BASH_VERSINFO[0]} -gt 4 ] || [ ${BASH_VERSINFO[0]} -eq 4 -a ${BASH_VERSINFO[1]} -ge 3 ]; then
    wait_for_a_step="wait -n"
else
    wait_for_a_step="sleep 1"
fi

# loop over each 'step' for which we are responsible.
# launch our ${command_file} lines, in the background, up to ${steps_at_once}
# at a time: once that many are running, start the next as soon as one finishes.
for step in $(seq ${start_idx} ${stop_idx}); do

    # the last PBS_ARRAY_INDEX could go past n_total_steps if the number of ${command_file}
    # is not evenly divisible by steps_per_node - don't let it
    [ ${step} -ge ${n_total_steps} ] && break

    # wait for a free slot
    running=( $(jobs -rp) )
    while [ ${#running[@]} -ge ${steps_at_once} ]; do
        ${wait_for_a_step}
        running=( $(jobs -rp) )
    done

    # get the command line arguments from ${command_file} for this step.
    # handles # comment lines in step too...)
    step_cmd=$(getline_from_file ${command_file} ${step} | cut -d'#' -f1)

    sleep $(( ${RANDOM} % $(( ${max_start_delay}+1 )) ))

    printf "%s launching step %05d: %s\n"  "[$(date +%Y-%m-%d" "%T" "%Z)]" $((${step}+1)) "${step_cmd}"

    # finally, launch our desired application with the requested arguments.  Redirect stdout/stderr to
    # the logs directory, and report when it finishes.  (The step runs in a subshell of its own, so
    # that it is reported even if it ends with "exit".)
    (
        ( eval "$step_cmd" ) > ./${logs_dir}/step-$(printf '%05d' $((${step}+1)) ).out 2>&1
        step_status=$?
        printf "%s finished  step %05d: exit status %d\n"  "[$(date +%Y-%m-%d" "%T" "%Z)]" $((${step}+1)) ${step_status}
    ) &
done

# wait for all the background processes to complete.
# (otherwise, when this script exits, PBS thinks it is done and will kill any remaining processes...)
wait

#----------------
tstop=$(date +%s)
elapsed=$((${tstop} - ${tstart}))

echo "Done: PBS_ARRAY_INDEX=${PBS_ARRAY_INDEX} took ${elapsed} seconds, finished on $(date)"
